<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="2026-06-12-05-notification-source-event" author="codex">
        <addColumn tableName="notification">
            <column name="source_event_id" type="BIGINT"/>
        </addColumn>
        <sql>UPDATE notification SET source_event_id = -id WHERE source_event_id IS NULL;</sql>
        <addNotNullConstraint tableName="notification" columnName="source_event_id" columnDataType="BIGINT"/>
        <addUniqueConstraint tableName="notification" columnNames="source_event_id,user_id"
                             constraintName="uk_notification_source_user"/>
    </changeSet>

    <changeSet id="2026-06-12-06-attachment-storage-cleanup" author="codex">
        <addColumn tableName="marketplace_attachment">
            <column name="storage_deleted_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="storage_deletion_attempts" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="storage_deletion_last_error" type="VARCHAR(1000)"/>
        </addColumn>
        <createIndex tableName="marketplace_attachment" indexName="idx_attachment_storage_cleanup">
            <column name="deleted_at"/>
            <column name="storage_deleted_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
