    <changeSet id="2026-05-25-04-category-metadata-and-translations" author="codex">
        <addColumn tableName="category">
            <column name="slug" type="VARCHAR(120)"/>
            <column name="icon" type="VARCHAR(80)"/>
            <column name="risk_level" type="VARCHAR(20)"/>
            <column name="service_mode" type="VARCHAR(20)"/>
            <column name="launch_phase" type="VARCHAR(40)"/>
            <column name="active" type="BOOLEAN"/>
            <column name="public_visible" type="BOOLEAN"/>
            <column name="sort_order" type="INT"/>
            <column name="requires_verification_level" type="VARCHAR(32)"/>
            <column name="requires_manual_approval" type="BOOLEAN"/>
            <column name="requires_license" type="BOOLEAN"/>
            <column name="allows_remote" type="BOOLEAN"/>
            <column name="allows_onsite" type="BOOLEAN"/>
            <column name="allows_escrow" type="BOOLEAN"/>
            <column name="allows_cash" type="BOOLEAN"/>
            <column name="allows_milestones" type="BOOLEAN"/>
            <column name="allows_attachments" type="BOOLEAN"/>
            <column name="allows_contact_reveal" type="BOOLEAN"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>

        <sql>
            UPDATE category
            SET slug = 'category-' || id,
                risk_level = 'LOW',
                service_mode = 'HYBRID',
                launch_phase = 'MVP',
                active = true,
                public_visible = true,
                sort_order = weight,
                requires_verification_level = 'NONE',
                requires_manual_approval = false,
                requires_license = false,
                allows_remote = true,
                allows_onsite = true,
                allows_escrow = false,
                allows_cash = true,
                allows_milestones = false,
                allows_attachments = true,
                allows_contact_reveal = false,
                created_at = CURRENT_TIMESTAMP,
                updated_at = CURRENT_TIMESTAMP;
        </sql>

        <addNotNullConstraint tableName="category" columnName="slug" columnDataType="VARCHAR(120)"/>
        <addNotNullConstraint tableName="category" columnName="risk_level" columnDataType="VARCHAR(20)"/>
        <addNotNullConstraint tableName="category" columnName="service_mode" columnDataType="VARCHAR(20)"/>
        <addNotNullConstraint tableName="category" columnName="launch_phase" columnDataType="VARCHAR(40)"/>
        <addNotNullConstraint tableName="category" columnName="active" columnDataType="BOOLEAN"/>
        <addNotNullConstraint tableName="category" columnName="public_visible" columnDataType="BOOLEAN"/>
        <addNotNullConstraint tableName="category" columnName="sort_order" columnDataType="INT"/>
        <addNotNullConstraint tableName="category" columnName="requires_verification_level" columnDataType="VARCHAR(32)"/>
        <addNotNullConstraint tableName="category" columnName="requires_manual_approval" columnDataType="BOOLEAN"/>
        <addNotNullConstraint tableName="category" columnName="requires_license" columnDataType="BOOLEAN"/>
        <addNotNullConstraint tableName="category" columnName="allows_remote" columnDataType="BOOLEAN"/>
        <addNotNullConstraint tableName="category" columnName="allows_onsite" columnDataType="BOOLEAN"/>
        <addNotNullConstraint tableName="category" columnName="allows_escrow" columnDataType="BOOLEAN"/>
        <addNotNullConstraint tableName="category" columnName="allows_cash" columnDataType="BOOLEAN"/>
        <addNotNullConstraint tableName="category" columnName="allows_milestones" columnDataType="BOOLEAN"/>
        <addNotNullConstraint tableName="category" columnName="allows_attachments" columnDataType="BOOLEAN"/>
        <addNotNullConstraint tableName="category" columnName="allows_contact_reveal" columnDataType="BOOLEAN"/>
        <addNotNullConstraint tableName="category" columnName="created_at" columnDataType="TIMESTAMP WITH TIME ZONE"/>
        <addNotNullConstraint tableName="category" columnName="updated_at" columnDataType="TIMESTAMP WITH TIME ZONE"/>
        <addUniqueConstraint tableName="category" columnNames="slug" constraintName="uc_category_slug"/>

        <createTable tableName="category_translation">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_category_translation"/>
            </column>
            <column name="category_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="locale" type="VARCHAR(8)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(2000)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="category_translation"
                                 baseColumnNames="category_id"
                                 constraintName="fk_category_translation_category"
                                 referencedTableName="category"
                                 referencedColumnNames="id"/>
        <addUniqueConstraint tableName="category_translation"
                             columnNames="category_id,locale"
                             constraintName="uc_category_translation_category_locale"/>

        <sql>
            INSERT INTO category_translation (category_id, locale, name, description, created_at, updated_at)
            SELECT id, 'ru', title, NULL, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP
            FROM category;

            INSERT INTO category_translation (category_id, locale, name, description, created_at, updated_at)
            SELECT id, 'kk', title, NULL, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP
            FROM category;
        </sql>
    </changeSet>
</databaseChangeLog>
