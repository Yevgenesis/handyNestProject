<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="2026-05-25-03-geo-directory" author="codex">
        <createTable tableName="country">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_country"/>
            </column>
            <column name="code" type="VARCHAR(2)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_country_code"/>
            </column>
            <column name="name_ru" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="name_kz" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="name_en" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="phone_code" type="VARCHAR(8)">
                <constraints nullable="false"/>
            </column>
            <column name="currency_code" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="is_supported" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="region">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_region"/>
            </column>
            <column name="public_id" type="VARCHAR(26)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_region_public_id"/>
            </column>
            <column name="country_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name_ru" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="name_kz" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="name_en" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="slug" type="VARCHAR(120)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_region_slug"/>
            </column>
            <column name="is_supported" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="city">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_city"/>
            </column>
            <column name="public_id" type="VARCHAR(26)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_city_public_id"/>
            </column>
            <column name="country_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="region_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name_ru" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="name_kz" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="name_en" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="slug" type="VARCHAR(120)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_city_slug"/>
            </column>
            <column name="latitude" type="DECIMAL(10,7)"/>
            <column name="longitude" type="DECIMAL(10,7)"/>
            <column name="is_supported" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="sort_order" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="district">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_district"/>
            </column>
            <column name="public_id" type="VARCHAR(26)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_district_public_id"/>
            </column>
            <column name="city_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name_ru" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="name_kz" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="name_en" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="slug" type="VARCHAR(120)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_district_slug"/>
            </column>
            <column name="latitude" type="DECIMAL(10,7)"/>
            <column name="longitude" type="DECIMAL(10,7)"/>
            <column name="is_supported" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="region"
                                 baseColumnNames="country_id"
                                 constraintName="fk_region_country"
                                 referencedTableName="country"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="city"
                                 baseColumnNames="country_id"
                                 constraintName="fk_city_country"
                                 referencedTableName="country"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="city"
                                 baseColumnNames="region_id"
                                 constraintName="fk_city_region"
                                 referencedTableName="region"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="district"
                                 baseColumnNames="city_id"
                                 constraintName="fk_district_city"
                                 referencedTableName="city"
                                 referencedColumnNames="id"/>

