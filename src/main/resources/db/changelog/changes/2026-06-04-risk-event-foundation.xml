<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="2026-06-04-06-risk-event-foundation" author="codex">
        <createTable tableName="risk_event">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_risk_event" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(26)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_risk_event_public_id"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="task_id" type="BIGINT"/>
            <column name="chat_id" type="BIGINT"/>
            <column name="chat_message_id" type="BIGINT"/>
            <column name="risk_type" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="severity" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="detected_text" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="normalized_detected_value" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="OPEN">
                <constraints nullable="false"/>
            </column>
            <column name="resolved_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="resolved_by_admin_id" type="BIGINT"/>
            <column name="resolution_comment" type="VARCHAR(1000)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="risk_event" baseColumnNames="user_id"
                                 referencedTableName="handy_user" referencedColumnNames="id"
                                 constraintName="fk_risk_event_user"/>
        <addForeignKeyConstraint baseTableName="risk_event" baseColumnNames="task_id"
                                 referencedTableName="marketplace_task" referencedColumnNames="id"
                                 constraintName="fk_risk_event_task"/>
        <addForeignKeyConstraint baseTableName="risk_event" baseColumnNames="chat_id"
                                 referencedTableName="deal_chat" referencedColumnNames="id"
                                 constraintName="fk_risk_event_chat"/>
        <addForeignKeyConstraint baseTableName="risk_event" baseColumnNames="chat_message_id"
                                 referencedTableName="chat_message" referencedColumnNames="id"
                                 constraintName="fk_risk_event_chat_message"/>
        <addForeignKeyConstraint baseTableName="risk_event" baseColumnNames="resolved_by_admin_id"
                                 referencedTableName="handy_user" referencedColumnNames="id"
                                 constraintName="fk_risk_event_resolved_by_admin"/>

        <createIndex tableName="risk_event" indexName="idx_risk_event_status_created">
            <column name="status"/>
            <column name="created_at"/>
        </createIndex>
        <createIndex tableName="risk_event" indexName="idx_risk_event_type_status">
            <column name="risk_type"/>
            <column name="status"/>
        </createIndex>
        <createIndex tableName="risk_event" indexName="idx_risk_event_severity_status">
            <column name="severity"/>
            <column name="status"/>
        </createIndex>
        <createIndex tableName="risk_event" indexName="idx_risk_event_chat_message">
            <column name="chat_message_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
