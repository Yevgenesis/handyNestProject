<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="2026-06-10-01-customer-risk-model" author="codex">
        <createTable tableName="customer_risk_adjustment">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_customer_risk_adjustment" nullable="false"/>
            </column>
            <column name="public_id" type="VARCHAR(26)">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uk_customer_risk_adjustment_public_id"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_customer_risk_adjustment_user"
                             referencedTableName="handy_user" referencedColumnNames="id"/>
            </column>
            <column name="source_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="source_public_id" type="VARCHAR(26)">
                <constraints nullable="false"/>
            </column>
            <column name="points" type="DECIMAL(5,2)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="reversed_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="customer_risk_adjustment"
                             columnNames="source_type,source_public_id"
                             constraintName="uk_customer_risk_adjustment_source"/>

        <createIndex tableName="customer_risk_adjustment" indexName="idx_customer_risk_adjustment_user_created">
            <column name="user_id"/>
            <column name="created_at"/>
        </createIndex>
        <createIndex tableName="customer_risk_adjustment" indexName="idx_customer_risk_adjustment_active">
            <column name="user_id"/>
            <column name="reversed_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
