<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="2026-06-07-01-data-retention-policy" author="codex">
        <createTable tableName="data_retention_policy">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_data_retention_policy" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(80)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_data_retention_policy_name"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="verification_document_retention_days" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_user_anonymization_days" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="chat_retention_days" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="audit_log_retention_days" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="attachment_retention_days" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE data_retention_policy
                ADD CONSTRAINT chk_data_retention_policy_days_positive CHECK (
                    verification_document_retention_days > 0
                    AND deleted_user_anonymization_days > 0
                    AND chat_retention_days > 0
                    AND audit_log_retention_days > 0
                    AND attachment_retention_days > 0
                );
        </sql>

        <insert tableName="data_retention_policy">
            <column name="name" value="default"/>
            <column name="active" valueBoolean="true"/>
            <column name="verification_document_retention_days" valueNumeric="90"/>
            <column name="deleted_user_anonymization_days" valueNumeric="30"/>
            <column name="chat_retention_days" valueNumeric="1095"/>
            <column name="audit_log_retention_days" valueNumeric="1825"/>
            <column name="attachment_retention_days" valueNumeric="365"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>

        <createIndex tableName="data_retention_policy" indexName="idx_data_retention_policy_active">
            <column name="active"/>
        </createIndex>

        <createIndex tableName="handy_user" indexName="idx_handy_user_status_deleted_at">
            <column name="status"/>
            <column name="deleted_at"/>
        </createIndex>

        <createIndex tableName="marketplace_attachment" indexName="idx_marketplace_attachment_type_deleted_at">
            <column name="attachment_type"/>
            <column name="deleted_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
