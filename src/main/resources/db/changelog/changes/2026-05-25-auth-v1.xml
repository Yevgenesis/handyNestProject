<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="2026-05-25-02-user-public-id-and-refresh-token" author="codex">
        <addColumn tableName="handy_user">
            <column name="public_id" type="VARCHAR(26)"/>
        </addColumn>

        <sql>
            UPDATE handy_user
            SET public_id = upper(substr(md5(id::text || ':' || email), 1, 26))
            WHERE public_id IS NULL;
        </sql>

        <addNotNullConstraint tableName="handy_user"
                              columnName="public_id"
                              columnDataType="VARCHAR(26)"/>

        <addUniqueConstraint tableName="handy_user"
                             columnNames="public_id"
                             constraintName="uc_handy_user_public_id"/>

        <createTable tableName="refresh_token">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_refresh_token"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="token_hash" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_refresh_token_token_hash"/>
            </column>
            <column name="expires_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="revoked_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="created_by_ip" type="VARCHAR(64)"/>
            <column name="revoked_by_ip" type="VARCHAR(64)"/>
            <column name="user_agent" type="VARCHAR(512)"/>
            <column name="device_name" type="VARCHAR(120)"/>
            <column name="replaced_by_token_id" type="BIGINT"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="refresh_token"
                                 baseColumnNames="user_id"
                                 constraintName="fk_refresh_token_user"
                                 referencedTableName="handy_user"
                                 referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="refresh_token"
                                 baseColumnNames="replaced_by_token_id"
                                 constraintName="fk_refresh_token_replacement"
                                 referencedTableName="refresh_token"
                                 referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>
