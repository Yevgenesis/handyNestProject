<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="2026-06-12-test-platform-settings" author="codex" context="test">
        <sql><![CDATA[
            UPDATE platform_setting
            SET setting_value = 'true', updated_at = CURRENT_TIMESTAMP
            WHERE setting_key IN (
                'feature.email-verification.enabled',
                'feature.payments.enabled',
                'feature.escrow.enabled'
            );
        ]]></sql>
    </changeSet>
</databaseChangeLog>
